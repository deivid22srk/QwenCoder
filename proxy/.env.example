# === QwenBridge — exemplo de configuração ===

# Porta HTTP do proxy
PORT=3000
HOST=0.0.0.0

# (Opcional) API key que o app QwenCoder precisa enviar via
# Authorization: Bearer ... — se vazio, fica aberto.
API_KEY=

# Contas Qwen no formato email:senha separadas por ;
# Também podem ser adicionadas via /v1/accounts do app QwenCoder
QWEN_ACCOUNTS=

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER=chromium

# Quota retry
QUOTA_RETRY_MAX_ATTEMPTS=5
